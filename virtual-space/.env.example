# ── Client (Vercel / local dev) ──────────────────────────────────────────
# WebSocket server URL. Use wss:// in production.
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── Server (Fly.io / local dev) ──────────────────────────────────────────
# Port the WebSocket/HTTP server listens on (Fly sets PORT automatically).
PORT=3001

# Comma-separated list of allowed WebSocket origins. Leave empty in dev.
# Example: https://virtual-space.vercel.app,https://my-domain.com
ALLOWED_ORIGINS=

# Optional tuning (defaults in parentheses)
# MAX_PLAYERS=50
# MAX_CONNECTIONS_PER_IP=3
# MOVE_MIN_MS=50
# CHAT_MIN_MS=200
# VENT_MIN_MS=500
# JUMP_MIN_MS=100
